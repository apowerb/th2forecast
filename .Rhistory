trees = ifelse(fit_model, trees, tune()),
min_n = ifelse(fit_model, min_n, tune()),
learn_rate = ifelse(fit_model, learn_rate, tune())
) %>%
parsnip::set_mode("regression") %>%
parsnip::set_engine("xgboost")
model_xgboost
