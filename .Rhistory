step_feature_selection <- function(recipe,
terms = dplyr::quo(value ~ .),
role = "predictor",
trained = FALSE,
feature_target,
list_features = c(),
lags = 5,
window = 5) {
add_step(
recipe,
step_feature_selection_new(
terms = terms,
role = role,
trained = trained,
feature_target = feature_target,
list_features = list_features,
lags = lags,
window = window
)
)
}
step_feature_selection_new <- function(terms = dplyr::quo(value ~ .),
role = "predictor",
trained = FALSE,
feature_target,
list_features = c(),
lags = 5,
window = 5) {
step(
subclass = "feature_selection",
terms = terms,
role = role,
trained = trained,
feature_target = feature_target,
list_features = list_features,
lags = lags,
window = window
)
}
prep.step_feature_selection <- function(x, training, info = NULL, ...) {
feature_selection(training, x$feature_target, x$list_features, x$lags, x$window)
}
bake.step_feature_selection <- function(object, newdata, ...) {
feature_selection(newdata, object$feature_target, object$list_features, object$lags, object$window)
}
